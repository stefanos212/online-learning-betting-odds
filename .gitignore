# ---------------------------------------------------------------- data ----
# odds_long.csv and odds_long_shin.csv are 118 MB and 134 MB. GitHub rejects
# any file over 100 MB outright, so these cannot be committed even if we wanted
# them to be. They are rebuilt from data/raw by scripts/data_processer.py.
data/processed/

# memoised panel tensors, keyed on the source CSV's mtime; pure derived state
data/cache/

# the raw football-data.co.uk downloads. Regenerable with
# scripts/download_data.ps1, and third-party data is better linked than
# redistributed.
data/raw/

# ------------------------------------------------------- local snapshots ---
# baselines taken before a refactor, for check_results.py to compare against.
# check_results.py save <NAME> writes the snapshot next to itself, in scripts/,
# so any such directory there is a snapshot and never source.
results_backup_*/
results_baseline_*/
scripts/PRE*/
scripts/BASELINE*/

# ------------------------------------------------------------- python -----
__pycache__/
*.py[cod]
.venv/
venv/

# -------------------------------------------------------------- latex -----
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
*.bbl
*.blg

# --------------------------------------------------------- not ours -------
# other students' theses, kept locally as formatting references only
docs/Kapourani_*.pdf
docs/Skoulas_*.pdf
docs/Tsampouras_*.pdf

# the signed assignment form: carries a phone number, student number and
# personal email, and has no business in a public repository
docs/DiplomatikiErgasia-AitisiAnathesis_*.pdf

# ------------------------------------------------- superseded write-ups ---
# The repository carries ONE edition of the thesis: docs/thesis_en_v2.tex (plus
# its generated appendix docs/appendix_tables_en.tex). Everything below is an
# earlier or parallel edition of the same work and is kept locally only, so the
# repo never shows two copies of the thesis.
docs/thesis.tex
docs/thesis.pdf
docs/appendix_tables.tex
docs/thesis_en.tex
docs/thesis_en.pdf
docs/status_report.tex
docs/status_report.pdf
docs/superseded/

# byte-identical duplicate of docs/tuc_logo.png, which is the one the thesis
# actually \includegraphics
docs/images.png

# side documents, not part of the report itself
docs/bibliography_notes.tex
docs/bibliography_notes.pdf
docs/defense_qa.tex
docs/defense_qa.pdf

# A stale copy of the thesis sat at the repository ROOT as well as in docs/,
# so GitHub showed it twice. Identical content, CRLF line endings. The leading
# slash matters: without it these patterns would also match docs/, which is
# where the real copy lives next to its appendix and logo.
/thesis_en_v2.tex
/thesis_en_v2.pdf

# --------------------------------------------------------- local state ----
# Claude Code's per-machine settings and lock files
.claude/

# ------------------------------------------------------------- node -------
# only needed to regenerate the slide deck with docs/build_deck.js
node_modules/

# ------------------------------------------------------------- misc -------
# LibreOffice leaves these behind while a file is open
docs/.~lock.*#
scripts/texput.log
.DS_Store
Thumbs.db
